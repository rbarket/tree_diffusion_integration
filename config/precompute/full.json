{
  "input_data": "data/processed/train_prefix_filtered.parquet",
  "output_dir": "data/precomputed/full",
  "integrand_column": "integrand_prefix",
  "integral_column": "integral_prefix",
  "train_limit": 1000000,
  "val_limit": null,
  "val_fraction": 0.0,
  "seed": 123,
  "shuffle_before_limit": true,
  "examples_per_pair_train": 2,
  "examples_per_pair_val": 2,
  "shard_size": 50000,
  "overwrite": false,
  "resume": false,
  "sigma_small": 2,
  "smax": 5,
  "rho": 0.2,
  "residual_mode": "both",
  "simplify_symbolic_residual": true,
  "max_input_length": 1024,
  "max_target_length": 128,
  "max_positions": 512,
  "max_random_size": null,
  "max_attempts": 32,
  "observation_timeout_seconds": 5.0,
  "observation_timeout_retries": 3,
  "allow_complex_constants": false,
  "allow_distributional_unary_ops": false,
  "excluded_random_tokens": [],
  "validate_labels": true,
  "require_strict_label_improvement": false,
  "max_failures": null,
  "write_failed_examples": true,
  "failed_examples_limit": 100,
  "num_workers": 32,
  "splits": ["train", "val"],
  "val_trajectory_mode": "none"
}
